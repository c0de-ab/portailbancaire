{
  "name": "portail-api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "pg": "^8.23.1",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFiles": [
      "<rootDir>/test/charger-env-test.ts"
    ]
  }
}
